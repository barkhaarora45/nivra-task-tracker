# ============================================================
# NIVRA Task Tracker — Backend Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value below (nothing here is secret — this file IS committed)
#   3. Your real .env is gitignored and must NEVER be committed
# ============================================================


# ── Google OAuth 2.0 ────────────────────────────────────────
# From: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Create a "Web application" type client. Add these Authorized redirect URIs:
#   http://localhost:3001/auth/callback          ← for local development
#   https://your-render-app.onrender.com/auth/callback  ← for production

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# This must EXACTLY match one of the redirect URIs you added in Cloud Console
# Change to your Render URL when deploying to production
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/callback


# ── Google Service Account (for Sheets read/write) ──────────
# From: Google Cloud Console → IAM & Admin → Service Accounts
# Steps:
#   1. Create a Service Account (give it any name, e.g. "nivra-sheets-bot")
#   2. Click the account → Keys tab → Add Key → Create new key → JSON
#   3. Download the JSON file
#   4. Paste the ENTIRE file contents as a single line below (no line breaks)
#      Tip: on Mac/Linux: cat key.json | tr -d '\n'
#           on Windows PowerShell: (Get-Content key.json -Raw) -replace "`n",""
#   5. Share your Google Sheet with the service account's email (found in the JSON as "client_email")
#      and give it Editor access

GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"nivra-sheets-bot@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}


# ── Google Sheets ────────────────────────────────────────────
# The ID of your Google Sheet. Find it in the Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
# The sheet must have a tab named "Tasks" with this header in row 1:
# id | title | owner | track | status | priority | due | notes

GOOGLE_SHEET_ID=your-google-sheet-id-here


# ── Access Control ───────────────────────────────────────────
# Comma-separated list of Google account emails allowed to log in.
# Anyone not on this list will be shown an "Access denied" message.
# No spaces around the commas.

ALLOWED_EMAILS=founder@gmail.com,intern1@gmail.com,intern2@gmail.com


# ── Session ──────────────────────────────────────────────────
# A long random string used to sign session cookies.
# Generate one by running this in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret — if it leaks, someone could forge session cookies.

SESSION_SECRET=replace-this-with-a-long-random-string


# ── Server ───────────────────────────────────────────────────
PORT=3001

# The URL where your React frontend is running
# Change to your Vercel URL when deploying to production
FRONTEND_URL=http://localhost:5173
